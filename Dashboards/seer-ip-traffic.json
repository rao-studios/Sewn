{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus / Mimir",
      "description": "Scaleway Cockpit Mimir datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",     "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus",  "version": "1.0.0" },
    { "type": "panel",      "id": "stat",       "name": "Stat",        "version": "" },
    { "type": "panel",      "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel",      "id": "geomap",     "name": "Geomap",      "version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",       "version": "" },
    { "type": "panel",      "id": "piechart",   "name": "Pie chart",   "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "IP-level traffic analysis: request volume by region, geographic origin map, and per-IP route explorer. Metrics use seer_http_requests_total labelled with route, region, country_code, and ip (full source address).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["seer", "traffic", "ip"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Seer — IP Traffic & Origins",
  "uid": "seer-ip-traffic",
  "version": 1,

  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(seer_http_requests_total, route)",
        "hide": 0,
        "includeAll": true,
        "label": "Route",
        "multi": true,
        "name": "route",
        "options": [],
        "query": {
          "query": "label_values(seer_http_requests_total, route)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(seer_http_requests_total, region)",
        "hide": 0,
        "includeAll": true,
        "label": "Region",
        "multi": true,
        "name": "region",
        "options": [],
        "query": {
          "query": "label_values(seer_http_requests_total, region)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },

  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "At a Glance",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Total inbound HTTP requests in the selected window, across all routes and regions. A sudden spike here without a matching spike in search latency usually means a new client population is hitting lightweight endpoints.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(increase(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[$__range]))",
          "legendFormat": "requests",
          "refId": "A"
        }
      ],
      "title": "Total Requests",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of distinct full IP addresses seen in the window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue",   "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red",    "value": 2000 }
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(count by (ip) (seer_http_requests_total{route=~\"$route\", region=~\"$region\"}))",
          "legendFormat": "unique IPs",
          "refId": "A"
        }
      ],
      "title": "Unique IPs",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current inbound request rate across all selected routes and regions. Compare to the baseline in the Overview dashboard; sustained elevation here without a product event usually points to a crawler or misconfigured client.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red",    "value": 200 }
          ]},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[2m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of distinct country_code label values seen in the window. A jump here alongside stable overall request rate means the same traffic is now arriving from more geographic origins — worth correlating with a VPN or CDN change.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(count by (country_code) (seer_http_requests_total{route=~\"$route\", region=~\"$region\"}))",
          "legendFormat": "countries",
          "refId": "A"
        }
      ],
      "title": "Active Countries",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Percentage of requests in the window that carry a resolved CDN country code (CF-IPCountry, CloudFront-Viewer-Country, or X-Country-Code). Values below 100 % mean traffic is arriving directly without a CDN hop — those requests appear in the IP table but are invisible on the geographic map because no country can be inferred. Route traffic through Cloudflare or CloudFront to raise this to 100 %.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "green",  "value": 95 }
          ]},
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 11,
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * sum(increase(seer_http_requests_total{route=~\"$route\", region=~\"$region\", country_code!=\"unknown\"}[$__range])) / sum(increase(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[$__range]))",
          "legendFormat": "CDN coverage",
          "refId": "A"
        }
      ],
      "title": "CDN Coverage",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Geographic Origin Map",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Bubble map of total requests in the selected window, grouped by country. Bubble size encodes request volume. Use the Route and Region variables above to filter down to a specific flow. Hover a bubble to see the country code and count; click to set a temporary ad-hoc filter. Data is resolved via Grafana's built-in ISO 3166-1 alpha-2 lookup — the metric must carry a country_code label (e.g. 'US', 'DE', 'SG').",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue",   "value": null },
            { "color": "purple", "value": 1000 },
            { "color": "red",    "value": 10000 }
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 14, "w": 16, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "basemap": {
          "config": {},
          "name": "Basemap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showScale": false,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "rules": [],
              "style": {
                "color": { "field": "Value", "fixed": "dark-blue" },
                "opacity": 0.6,
                "rotation": { "fixed": 0, "max": 360, "min": -360, "mode": "mod" },
                "size": { "field": "Value", "fixed": 5, "max": 30, "min": 3, "mode": "linear" },
                "symbol": { "fixed": "img/icons/marker/circle.svg", "mode": "fixed" },
                "symbolAlign": { "h": "center", "v": "center" },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "location": { "gazetteer": "public/gazetteer/countries.json", "lookup": "country_code", "mode": "lookup" },
            "name": "Requests by Country",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": { "mode": "details" },
        "view": { "allLayers": true, "id": "zero", "lat": 26, "lon": 12, "zoom": 2 }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (country_code) (increase(seer_http_requests_total{route=~\"$route\", region=~\"$region\", country_code!=\"unknown\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{country_code}}",
          "refId": "A"
        }
      ],
      "title": "Requests by Country",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": { "country_code": "country_code", "Value": "Value" }
          }
        }
      ],
      "type": "geomap"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Share of total requests broken down by route during the selected window. A dominant single route is expected (e.g. /v1/search); unexpected growth in a debug or reset route warrants investigation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 14, "w": 8, "x": 16, "y": 6 },
      "id": 6,
      "options": {
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "bottom", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (route) (increase(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "Traffic Share by Route",
      "type": "piechart"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "Regional Request Trends",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Request rate over time, one series per cloud region. Use this to spot traffic shifts between regions — e.g. a CDN failover routing EU traffic to US-EAST, or an Asia-Pacific user base growing over a deploy window. Each region series corresponds to the `region` label on seer_http_requests_total.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (region) (rate(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[2m]))",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Region",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Per-region stacked view of requests broken out by route. Use this to understand which routes are generating traffic in each region — e.g. if /v1/frank/reset spikes in eu-west but not us-east, a specific client or deploy script is likely the cause.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (region, route) (rate(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[2m]))",
          "legendFormat": "{{region}} — {{route}}",
          "refId": "A"
        }
      ],
      "title": "Stacked Requests by Region & Route",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 103,
      "title": "IP & Route Explorer",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Sortable table of every IP address seen in the window with its associated region, country, and the routes it called. Sort by 'Total Requests' descending to find the highest-volume sources.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red",    "value": 5000 }
          ]}
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total Requests" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } },
              { "id": "unit", "value": "short" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "req/s (2m)" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "sparkline" } },
              { "id": "unit", "value": "reqps" }
            ]
          }
        ]
      },
      "gridPos": { "h": 14, "w": 14, "x": 0, "y": 38 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Total Requests" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (ip, region, country_code, route) (increase(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "IP → Region → Route Breakdown",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "ip":           "IP Address",
              "region":       "Region",
              "country_code": "Country",
              "route":        "Route",
              "Value":        "Total Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": [{ "desc": true, "displayName": "Total Requests" }] }
        }
      ],
      "type": "table"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Request rate over time for the top IPs by volume. Helps identify whether a high-volume address is bursty (batch job or bot) or steady (legitimate active user). Flat lines that suddenly appear and disappear suggest automated tooling.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 4,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 14, "w": 10, "x": 14, "y": 38 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["max", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk(10, sum by (ip) (rate(seer_http_requests_total{route=~\"$route\", region=~\"$region\"}[2m])))",
          "legendFormat": "{{ip}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 IPs — Rate Over Time",
      "type": "timeseries"
    }

  ]
}
