          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, rate(provider_embedding_request_duration_bucket[5m])) * 1000",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "title": "Embedding Round-Trip Duration",
      "type": "timeseries"
    }
  ]
}
