      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * rate(sewn_search_path_total{path=~\"global_hnsw|personal_hnsw\"}[5m]) / rate(sewn_search_total[5m])",
          "legendFormat": "HNSW hit %",
          "refId": "A"
        }
